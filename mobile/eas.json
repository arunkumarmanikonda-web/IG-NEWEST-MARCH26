{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "local" },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "simulator": {
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "production": {
      "distribution": "store",
      "android": { "buildType": "app-bundle" },
      "ios": { "simulator": false }
    }
  },
  "submit": { "production": {} }
}
