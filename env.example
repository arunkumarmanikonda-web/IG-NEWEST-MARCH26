# Public values: point only to the database for the current environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only random secret, minimum 40 characters; store only its SHA256 in ig_private.ingest_config.
ENQUIRY_INGEST_SECRET=
# Keep search indexing off until live-domain acceptance.
SEARCH_INDEXING_ENABLED=false
# Optional HTTPS canonical origin; defaults to the current Vercel deployment.
# NEXT_PUBLIC_SITE_URL=https://www.indiagully.com

# Server-only data-room preview broker token. Store SHA256 in ig_private.room_config.
DATAROOM_BROKER_SECRET=

# Server-only 32-byte hex encryption root; keep a secure backup.
INTEGRATION_MASTER_KEY=
