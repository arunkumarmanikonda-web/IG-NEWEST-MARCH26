# Public values: point only to the database for the current environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only random secret, minimum 40 characters; store only its SHA256 in ig_private.ingest_config.
ENQUIRY_INGEST_SECRET=
# Keep search indexing off until live-domain acceptance.
SEARCH_INDEXING_ENABLED=false
# Optional HTTPS canonical origin; defaults to the current Vercel deployment.
# NEXT_PUBLIC_SITE_URL=https://www.indiagully.com

# Server-only data-room preview broker token. Store SHA256 in ig_private.room_config.
DATAROOM_BROKER_SECRET=

# Server-only 32-byte hex encryption root; keep a secure backup.
INTEGRATION_MASTER_KEY=

# Server-only provider credentials; CMS overrides take precedence when set.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_WORKER_SECRET=

OPENAI_API_KEY=
RUNWAYML_API_SECRET=
FAST2SMS_API_KEY=

# Production-only Razorpay staging. Never set in Preview or Development.
# Enter through Vercel Secrets, then redeploy production and import in owner settings.
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# Optional Google Ads measurement for signed-in contacts who opted into this practice
NEXT_PUBLIC_ADVERTISING_INSTALLED=false
GOOGLE_ADS_TAG_ID=
GOOGLE_ADS_ENQUIRY_LABEL=
